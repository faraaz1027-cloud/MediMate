{
  "info": {
    "name": "MediMate Step 23 C1 tasks (Telegram disabled; live receipt not verified)",
    "description": "Synthetic organizer/caregiver API workflow. Run with Telegram disabled; this collection does not send Telegram messages.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
