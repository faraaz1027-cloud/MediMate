    {
      "name": "Validation rejects mass assignment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrfToken}}"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{operationKey}}"
          }
        ],
        "url": "{{baseUrl}}/patients/{{patientId}}/cabinet-items",
        "body": {
          "mode": "raw",
          "raw": "{\"displayName\": \"Bad\", \"entryType\": \"manual\", \"patientId\": \"000000000000000000000000\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 422',()=>pm.response.to.have.status(422));",
              "const payload=pm.response.json();",
              "pm.test('Request identifier',()=>pm.expect(payload.meta.requestId).to.be.a('string'));",
              "pm.test('Validation code',()=>pm.expect(payload.error.code).to.equal('VALIDATION_ERROR'));"
            ]
          }
        }
