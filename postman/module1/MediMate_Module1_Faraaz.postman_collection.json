        {
          "name": "Anonymous CSRF",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "['cookie','csrf','ownerCookie','ownerCsrf','readerCookie','readerCsrf','careCookie','careCsrf'].forEach(k => pm.collectionVariables.unset(k));",
                  "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
                  "pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.collectionVariables.get('csrf')||''});",
                  "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "const d=pm.response.json().data;pm.collectionVariables.set('csrf',d.csrfToken);pm.collectionVariables.set('cookie',pm.response.headers.get('set-cookie').split(';')[0]);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/csrf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "csrf"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
