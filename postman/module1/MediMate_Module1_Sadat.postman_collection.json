{
  "info": {
    "name": "MediMate Module 1 Sadat A1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Current Module 1-only export of the tested final Assignment 03 collection. All setup/intermediate requests in the A1 folder are retained. Synthetic data; Telegram intentionally disabled in this collection; real receipt is a separate manual gate. Original full A1/A2, B1/B2 and C1/C2 collections remain unchanged."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:1499/api/v1"
    }
  ],
  "item": [
