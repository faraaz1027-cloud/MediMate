              "pm.test('Replacement is current',()=>pm.expect(pm.response.json().data.currentVersion.id).to.eql(pm.collectionVariables.get('v2')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/patients/{{patientId}}/prescriptions/{{prescriptionId}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
