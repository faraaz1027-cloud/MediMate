            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"expectedRevision\":0,\"reviewed\":true}"
        }
      }
    },
    {
      "name": "Retained immutable history",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
              "pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.collectionVariables.get('csrf')||''});",
              "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const versions=pm.response.json().data;pm.test('Both versions retained',()=>pm.expect(versions.length).to.eql(2));",
              "pm.test('Original quantity unchanged',()=>pm.expect(versions.find(v=>v.id===pm.collectionVariables.get('v1')).instructions[0].doseQuantity).to.eql('1.25'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/patients/{{patientId}}/prescriptions/{{prescriptionId}}/versions",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Read current version",
      "protocolProfileBehavior": {
