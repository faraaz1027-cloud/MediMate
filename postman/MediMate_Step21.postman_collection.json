{
  "info": {
    "name": "MediMate Step 21 A1 prescription review",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001/api/v1"
    }
  ],
  "item": [
    {
      "name": "Anonymous CSRF",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
              "pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.collectionVariables.get('csrf')||''});",
              "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "const d=pm.response.json().data;pm.collectionVariables.set('csrf',d.csrfToken);pm.collectionVariables.set('cookie',pm.response.headers.get('set-cookie').split(';')[0]);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/csrf",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Register synthetic reviewer",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
              "pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.collectionVariables.get('csrf')||''});",
              "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const d=pm.response.json().data;pm.collectionVariables.set('csrf',d.csrfToken);pm.collectionVariables.set('cookie',pm.response.headers.get('set-cookie').split(';')[0]);",
              "pm.collectionVariables.set('patientId',d.patientId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/register",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"a1-{{$guid}}@example.test\",\"password\":\"Synthetic-pass-123!\",\"displayName\":\"A1 Postman review\"}"
        }
      }
    },
    {
      "name": "Create incomplete unconfirmed draft",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
              "pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.collectionVariables.get('csrf')||''});",
              "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "const d=pm.response.json().data;pm.collectionVariables.set('prescriptionId',d.prescription.id);pm.collectionVariables.set('v1',d.draftVersion.id);",
              "pm.test('No current confirmed pointer',()=>pm.expect(pm.response.json().data.prescription.currentVersionId).to.eql(undefined));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/patients/{{patientId}}/prescriptions",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"A1 Postman synthetic\",\"instructions\":[{\"lineNumber\":1,\"medicineText\":\"Demo medicine\",\"instructionsText\":\"Synthetic transcription\",\"clarificationRequired\":true}]}"
        }
      }
    },
    {
      "name": "Incomplete draft cannot confirm",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
              "pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.collectionVariables.get('csrf')||''});",
              "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 422',()=>pm.response.to.have.status(422));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/patients/{{patientId}}/prescriptions/{{prescriptionId}}/versions/{{v1}}/confirm",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"expectedRevision\":0,\"reviewed\":true}"
        }
      }
    },
    {
      "name": "Complete reviewed draft fields",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
              "pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.collectionVariables.get('csrf')||''});",
              "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/patients/{{patientId}}/prescriptions/{{prescriptionId}}/versions/{{v1}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"expectedRevision\":0,\"instructions\":[{\"lineNumber\":1,\"medicineText\":\"Demo medicine\",\"instructionsText\":\"Synthetic transcription only\",\"clarificationRequired\":false,\"doseQuantity\":\"1.25\",\"doseUnit\":\"tablet\",\"frequencyText\":\"Synthetic timing\",\"durationText\":\"Synthetic duration\"}],\"reviewCorrections\":\"Synthetic correction\"}"
        }
      }
    },
    {
      "name": "Confirm explicit review",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
              "pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.collectionVariables.get('csrf')||''});",
              "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Confirmed with time',()=>pm.expect(pm.response.json().data.currentVersion.confirmedAt).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/patients/{{patientId}}/prescriptions/{{prescriptionId}}/versions/{{v1}}/confirm",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"expectedRevision\":1,\"reviewed\":true}"
        }
      }
    },
    {
      "name": "Confirmed version is immutable",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
              "pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.collectionVariables.get('csrf')||''});",
              "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409',()=>pm.response.to.have.status(409));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "url": "{{baseUrl}}/patients/{{patientId}}/prescriptions/{{prescriptionId}}/versions/{{v1}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"expectedRevision\":2,\"instructions\":[{\"lineNumber\":1,\"medicineText\":\"Demo medicine\",\"instructionsText\":\"Synthetic transcription only\",\"clarificationRequired\":false,\"doseQuantity\":\"1.25\",\"doseUnit\":\"tablet\",\"frequencyText\":\"Synthetic timing\",\"durationText\":\"Synthetic duration\"}]}"
        }
      }
    },
    {
      "name": "Create replacement draft",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
              "pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.collectionVariables.get('csrf')||''});",
              "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('v2',pm.response.json().data.draftVersion.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/patients/{{patientId}}/prescriptions/{{prescriptionId}}/versions",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"expectedRevision\":2,\"previousVersionId\":\"{{v1}}\",\"instructions\":[{\"lineNumber\":1,\"medicineText\":\"Demo medicine\",\"instructionsText\":\"Synthetic transcription only\",\"clarificationRequired\":false,\"doseQuantity\":\"2\",\"doseUnit\":\"tablet\",\"frequencyText\":\"Synthetic timing\",\"durationText\":\"Synthetic duration\"}]}"
        }
      }
    },
    {
      "name": "Compare changed quantity",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
              "pm.request.headers.upsert({key:'X-CSRF-Token',value:pm.collectionVariables.get('csrf')||''});",
              "pm.request.headers.upsert({key:'Idempotency-Key',value:pm.variables.replaceIn('{{$guid}}')});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
              "pm.test('Quantity difference',()=>pm.expect(pm.response.json().data.changed[0].fields).to.deep.include({field:'doseQuantity',before:'1.25',after:'2'}));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/patients/{{patientId}}/prescriptions/{{prescriptionId}}/comparison?fromVersionId={{v1}}&toVersionId={{v2}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
      "name": "Confirm replacement",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.request.headers.upsert({key:'Cookie',value:pm.collectionVariables.get('cookie')||''});",
