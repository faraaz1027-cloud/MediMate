# Step 17 needs a replica set for transactions; see docs/STEP_17_API_IMPLEMENTATION.md.
MONGODB_URI=mongodb://127.0.0.1:27018/medimate_demo?replicaSet=medimate
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional Step 23 Telegram integration. Leave blank to keep it disabled.
# Set real values only in ignored server/.env; never commit a bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# A separate `npm run worker -w server` process polls the bot and sends queued notices.
# Run one poller per bot; an existing webhook must be removed by the bot owner first.
# Production sets NODE_ENV=production and serves API behind HTTPS.
